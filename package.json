{
  "name": "stitchsafe",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "e2e": "playwright test",
    "api:test": "newman run postman/stitchsafe.postman_collection.json -e postman/local.environment.json",
    "paypal:smoke": "tsx scripts/paypal-smoke.ts",
    "ai:smoke": "tsx scripts/ai-smoke.ts",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@google/genai": "1.52.0",
    "@paypal/react-paypal-js": "10.1.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@supabase/supabase-js": "2.119.0",
    "dotenv": "^16.4.0",
    "firebase": "13.2.0",
    "firebase-admin": "14.5.0",
    "lucide-react": "^0.454.0",
    "next": "16.4.5",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.11.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "6.37.0",
    "sharp": "^0.33.0",
    "swr": "^2.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.5",
    "newman": "6.2.3",
    "postcss": "^8.4.0",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "sharp@0.35.5": true,
    "sharp@0.33.5": true,
    "protobufjs@7.6.6": true,
    "@firebase/util@1.15.3": true,
    "@google/genai@1.52.0": true,
    "esbuild@0.28.2": true,
    "vite@6.4.5": true,
    "esbuild@0.25.12": true
  }
